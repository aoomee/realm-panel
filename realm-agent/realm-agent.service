# Reference unit — install.sh writes this automatically.
[Unit]
Description=realm-panel agent (receives config from panel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# AGENT_TOKEN / AGENT_PORT / REALM_CONFIG / REALM_SERVICE, chmod 600
EnvironmentFile=/etc/realm/agent.env
ExecStart=/usr/bin/python3 /usr/local/bin/realm-agent
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
